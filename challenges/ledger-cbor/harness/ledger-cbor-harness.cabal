cabal-version: 3.0
name: ledger-cbor-harness
version: 0.1.0.0
build-type: Simple

executable ledger-cbor-harness
  main-is: Main.hs
  other-modules: HeapWalk
  default-language: Haskell2010
  -- no full laziness: keep repeated decodes inside the loop.
  -- -V0: no RTS timer ticks, so Callgrind counts don't depend on wall time.
  ghc-options: -O2 -fno-full-laziness "-with-rtsopts=-V0"
  build-depends:
    base,
    base16-bytestring,
    bytestring,
    cardano-crypto-class,
    cardano-ledger-binary,
    cardano-ledger-conway,
    cardano-ledger-core,
    deepseq,
    ghc-heap,
