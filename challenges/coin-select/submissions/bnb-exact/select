#!/usr/bin/env python3
"""bnb-exact: branch and bound for a no-change selection, else lf-consolidate.

For each payment, search for the fewest inputs (1, then 2, then up to MAX_DEPTH)
whose total lands in [need + min_fee, need + min_fee + cost_of_change], where
cost_of_change = the fee of one change output now plus the fee of spending it
later (Bitcoin Core's window). Such a selection needs no change output; the
leftover goes into the fee. Otherwise fall back to lf-consolidate: largest-first
with one change output plus up to MAX_EXTRA of the smallest UTxOs under DUST."""
import json
import sys

DUST = 2_000_000  # the judge's dust line
MAX_EXTRA = 2
MAX_DEPTH = 3
BUDGET = 20000  # search nodes per depth, bounds latency


def main():
    p = None
    wallet = {}
    for line in sys.stdin:
        msg = json.loads(line)
        t = msg["type"]
        if t == "params":
            p = msg
        elif t == "deposit":
            for u in msg["utxos"]:
                wallet[u["id"]] = u["lovelace"]
        elif t == "pay":
            reply = select(p, wallet, [o["lovelace"] for o in msg["outputs"]])
            if reply is None:
                out = {"refuse": True}
            else:
                for i in reply["inputs"]:
                    del wallet[i]
                for k, c in enumerate(reply["change"]):
                    wallet["%s#%d" % (msg["id"], k)] = c
                out = reply
            sys.stdout.write(json.dumps(out) + "\n")
            sys.stdout.flush()
        elif t == "end":
            return


def select(p, wallet, outs):
    ids = exact(p, wallet, outs)
    if ids:
        return {"inputs": ids, "change": [], "fee": sum(wallet[i] for i in ids) - sum(outs)}
    return select_lfc(p, wallet, outs)


def exact(p, wallet, outs):
    sz = p["size"]
    need, n_outs = sum(outs), len(outs)
    window = p["min_fee_a"] * (sz["output"] + sz["input"])
    items = sorted(wallet.items(), key=lambda kv: (-kv[1], kv[0]))
    vals = [v for _, v in items]
    suffix = [0] * (len(vals) + 1)
    for i in range(len(vals) - 1, -1, -1):
        suffix[i] = suffix[i + 1] + vals[i]

    def lo(n):  # least total that pays the outputs and the min fee with n inputs
        return need + p["min_fee_a"] * (sz["base"] + sz["input"] * n + sz["output"] * n_outs) + p["min_fee_b"]

    for depth in range(1, MAX_DEPTH + 1):
        stack, tries, found = [], [0], []

        def dfs(i, s, n):
            tries[0] += 1
            if tries[0] > BUDGET or found:
                return
            if n == depth:
                if lo(n) <= s <= lo(n) + window:
                    found.append(list(stack))
                return
            for j in range(i, len(vals)):
                if s + vals[j] > lo(n + 1) + window:
                    continue  # too big at this depth: try a smaller one
                if s + suffix[j] < lo(n + 1):
                    return  # everything left is too small
                stack.append(j)
                dfs(j + 1, s + vals[j], n + 1)
                stack.pop()
                if found or tries[0] > BUDGET:
                    return

        dfs(0, 0, 0)
        if found:
            return [items[j][0] for j in found[0]]
    return None


def select_lfc(p, wallet, outs):
    sz = p["size"]

    def fee(n_in, n_out):
        size = sz["base"] + sz["input"] * n_in + sz["output"] * n_out
        return p["min_fee_a"] * size + p["min_fee_b"], size

    min_ada = (160 + sz["output"]) * p["coins_per_utxo_byte"]
    need = sum(outs)
    total, picked = 0, []
    base = None
    for uid in sorted(wallet, key=lambda i: (-wallet[i], i)):
        picked.append(uid)
        total += wallet[uid]
        base = finish(fee, min_ada, p, picked, total, need, len(outs))
        if base is False:
            return None
        if base:
            break
    if not base:
        return None
    # consolidation: add the smallest dust UTxOs worth more than their input fee
    in_fee = p["min_fee_a"] * sz["input"]
    chosen = set(picked)
    smalls = sorted((wallet[u], u) for u in wallet
                    if u not in chosen and in_fee < wallet[u] < DUST)
    for v, u in smalls[:MAX_EXTRA]:
        r = finish(fee, min_ada, p, picked + [u], total + v, need, len(outs))
        if not r:
            break
        picked.append(u)
        total += v
        base = r
    return base


def finish(fee, min_ada, p, picked, total, need, n_outs):
    """Reply for these inputs; None if they do not cover; False if too big."""
    n = len(picked)
    fee_c, size = fee(n, n_outs + 1)
    if size > p["max_tx_size"]:
        return False
    spare = total - need
    if spare - fee_c >= min_ada:
        return {"inputs": list(picked), "change": [spare - fee_c], "fee": fee_c}
    if spare >= fee(n, n_outs)[0]:
        return {"inputs": list(picked), "change": [], "fee": spare}
    return None


main()
